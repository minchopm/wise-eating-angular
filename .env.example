# Copy to .env and fill in. .env is gitignored — never commit it.

# --- AWS ---------------------------------------------------------------
NG_DEPLOY_AWS_ACCESS_KEY_ID=
NG_DEPLOY_AWS_SECRET_ACCESS_KEY=
NG_DEPLOY_AWS_BUCKET=www.wise-eating.com
NG_DEPLOY_AWS_REGION=us-east-2

# --- Optional ----------------------------------------------------------
# Skip the alias lookup on every deploy by pinning the distribution.
CLOUDFRONT_DISTRIBUTION_ID=E2IVXQWQBW4XTA

# The PUBLIC hostname. Set it whenever it differs from the bucket name.
SITE_DOMAIN=www.wise-eating.com

# Angular project name; must match angular.json.
# ANGULAR_PROJECT=wise-eating-web

# Absolute paths, if the binaries are not on PATH.
# NPM_BIN=
# AWS_BIN=
