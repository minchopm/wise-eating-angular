{
  "name": "wise-eating-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node tools/postbuild.mjs",
    "build:dev": "ng build --configuration development && node tools/postbuild.mjs",
    "watch": "ng build --watch --configuration development",
    "images": "python3 tools/build-images.py",
    "deploy": "./scripts/deploy.sh",
    "deploy:dry": "DRY_RUN=1 ./scripts/deploy.sh",
    "deploy:skip-build": "SKIP_BUILD=1 ./scripts/deploy.sh",
    "deploy:invalidate": "INVALIDATE_ONLY=1 ./scripts/deploy.sh",
    "provision": "./scripts/provision.sh",
    "shots": "node tools/fetch-store-shots.mjs && python3 tools/build-images.py",
    "globe": "python3 tools/build-globe.py",
    "content": "python3 tools/build-nutrient-data.py"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^19.2.25",
    "@angular/compiler": "^19.2.25",
    "@angular/core": "^19.2.25",
    "@angular/forms": "^19.2.25",
    "@angular/platform-browser": "^19.2.25",
    "@angular/platform-browser-dynamic": "^19.2.25",
    "@angular/platform-server": "^19.2.25",
    "@angular/router": "^19.2.25",
    "@angular/ssr": "^19.2.25",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "rxjs": "~7.8.0",
    "three": "^0.169.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.27",
    "@angular/cli": "^19.2.27",
    "@angular/compiler-cli": "^19.2.25",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.19.43",
    "@types/three": "^0.169.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.7.2"
  },
  "description": "The website for Wise Eating \u2014 Angular, prerendered, with a WebGL title sequence."
}
